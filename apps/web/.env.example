# Database URL for PostgreSQL
DATABASE_URL=
BETTER_AUTH_SECRET=
# Base URL of your app
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Canonical public origin for the marketing pages' canonical and Open Graph
# URLs. Falls back to BETTER_AUTH_URL when unset; set it explicitly wherever the
# app is reachable on more than one host (preview domains, www vs apex).
SITE_URL=
# Outbound mail. With no API key set, nothing is sent and nothing fails — which
# is how local dev and CI run. RESEND_FROM is required whenever the key is set.
RESEND_API_KEY=
RESEND_FROM=
# Billing. With no secret key set, billing is switched off entirely — which is
# how a fresh clone and CI run. Set the key and the other three become required
# too: the app refuses to start on a half-configured deployment rather than
# failing under the first customer to press Subscribe.
#
# The secret key comes from the Dashboard under Workbench → API keys, and the
# price identifiers from the Pro product's price rows. The signing secret
# belongs to one webhook destination, so it differs per environment — locally
# it is whatever `stripe listen` prints, which is not the same secret as any
# destination's and cannot stand in for one. See
# docs/runbooks/stripe-managed-payments.md for the setup that has to happen in
# the Dashboard first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Error monitoring. With no DSN set, nothing is sent and nothing fails — which
# is how a fresh clone and CI run. The same project DSN works for both the
# server and the browser; the Vite-prefixed copy is what the client bundle is
# allowed to see. Optional SENTRY_ENVIRONMENT names the environment in Sentry
# (production, preview, …) and falls back to NODE_ENV when unset.
#
# Source-map upload at build time needs the auth token plus org and project
# slugs together. Without them the app still reports errors, just without
# readable production stacks.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
