{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", "eslint.config.js"]
}
