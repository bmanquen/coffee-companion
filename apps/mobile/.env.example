# Public origin of the Coffee Companion API (the web app). The phone must be
# able to reach it. iOS Simulator: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# A physical device: http://<your-lan-ip>:3000 or the deployed origin.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Auth Platform > Clients in project coffee-companion-483117.
# Create iOS and Android OAuth clients whose bundle ID / package is
# dev.offbyonelabs.coffeecompanion. The Android client ID is server-only
# (GOOGLE_ANDROID_CLIENT_ID).
#
# Web client ID (same value as GOOGLE_CLIENT_ID on the server). Native
# Google Sign-In mints an ID token whose audience is this Web client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS OAuth client ID. Also set GOOGLE_IOS_CLIENT_ID on the server.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc
# Required for a native iOS build (Info.plist URL scheme). Not a secret —
# it ships in the binary — but it is environment-specific, so it is read here.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
